{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "proto",
  "projectType": "library",
  "targets": {
    "lint": {
      "inputs": ["protoContracts", "jsTooling"],
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm proto:lint"
      }
    },
    "format": {
      "inputs": ["protoContracts", "jsTooling"],
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm proto:format"
      }
    },
    "check": {
      "inputs": ["protoContracts", "jsTooling"],
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": ["pnpm proto:lint", "pnpm proto:format:check"],
        "parallel": false
      }
    }
  }
}
