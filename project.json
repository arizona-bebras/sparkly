{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "proto",
  "projectType": "library",
  "targets": {
    "lint": {
      "inputs": ["protoContracts", "jsTooling"],
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm proto:lint"
      }
    },
    "format": {
      "inputs": ["protoContracts", "jsTooling"],
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm proto:format"
      }
    },
    "check": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": ["lint", "format:check"]
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["protoContracts", "jsTooling"],
      "outputs": [],
      "options": {
        "command": "pnpm proto:format:check"
      }
    }
  }
}
