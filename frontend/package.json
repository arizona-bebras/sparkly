{
	"name": "sparkly-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "pnpm run check && vite build",
		"proto-generate": "npx buf generate --template ./proto/buf.gen.yaml",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json",
		"prepare": "svelte-kit sync"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@bufbuild/buf": "^1.73.0",
		"@bufbuild/protoc-gen-es": "^2.16.0",
		"@sveltejs/adapter-node": "^5.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^22.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.9.0",
		"vite": "^7.0.0"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.16.0",
		"@connectrpc/connect": "^2.2.0",
		"@connectrpc/connect-web": "^2.2.0",
		"@tanstack/svelte-query": "^6.3.1",
		"@tanstack/svelte-query-devtools": "^6.3.1"
	}
}
