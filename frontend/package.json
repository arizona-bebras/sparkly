  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.9.0",
    "svelte-check": "^4.0.0",
    "@types/node": "^22.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/adapter-node": "^5.0.0"
  }
}
