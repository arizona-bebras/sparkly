{
  "name": "sparkly-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "pnpm run check && vp build",
    "proto-generate": "npx buf generate .. --template proto/buf.gen.yaml --path ../backend/proto/service.proto",
    "preview": "vp preview",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run check:types",
    "check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-query": "^6.3.1",
    "@tanstack/svelte-query-devtools": "^6.3.1",
    "@tanstack/svelte-table": "^9.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.0.0",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "formsnap": "^2.0.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "sveltekit-superforms": "^2.31.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.6.7"
  }
}
