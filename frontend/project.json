{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "frontend",
  "projectType": "application",
  "sourceRoot": "frontend/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run lint",
        "cwd": "frontend"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run lint:fix",
        "cwd": "frontend"
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run fmt",
        "cwd": "frontend"
      }
    },
    "fmt:check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run fmt:check",
        "cwd": "frontend"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm run build",
        "cwd": "frontend"
      },
      "outputs": ["{projectRoot}/build", "{projectRoot}/.svelte-kit"],
      "inputs": ["default", "jsTooling"]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run check",
        "cwd": "frontend"
      },
      "outputs": [],
      "inputs": ["default", "jsTooling"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run dev",
        "cwd": "frontend"
      },
      "outputs": [],
      "inputs": ["default", "jsTooling"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run preview",
        "cwd": "frontend"
      },
      "outputs": [],
      "inputs": ["default", "jsTooling"]
    }
  }
}
