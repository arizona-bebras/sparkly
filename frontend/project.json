{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "frontend",
  "projectType": "application",
  "sourceRoot": "frontend/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm run build",
        "cwd": "frontend"
      },
      "outputs": [
        "{projectRoot}/build",
        "{projectRoot}/.svelte-kit"
      ],
      "inputs": [
        "default",
        "jsTooling"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run check",
        "cwd": "frontend"
      },
      "outputs": [],
      "inputs": [
        "default",
        "jsTooling"
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run dev",
        "cwd": "frontend"
      },
      "outputs": [],
      "inputs": [
        "default",
        "jsTooling"
      ]
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run preview",
        "cwd": "frontend"
      },
      "outputs": [],
      "inputs": [
        "default",
        "jsTooling"
      ]
    }
  }
}
