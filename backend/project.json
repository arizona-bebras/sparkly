{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "backend",
  "projectType": "application",
  "sourceRoot": "backend",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "go build -o bin/backend ./cmd/backend",
        "cwd": "backend"
      },
      "outputs": [
        "{projectRoot}/bin"
      ],
      "inputs": [
        "default",
        {
          "runtime": "go version"
        },
        {
          "env": "GOOS"
        },
        {
          "env": "GOARCH"
        },
        {
          "env": "CGO_ENABLED"
        },
        {
          "env": "GOFLAGS"
        }
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run ./cmd/backend",
        "cwd": "backend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go vet ./...",
        "cwd": "backend"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "gofmt -w .",
        "cwd": "backend"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../tools/check-go-format.mjs",
        "cwd": "backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go test ./...",
        "cwd": "backend"
      }
    },
    "check": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        "lint",
        "format:check",
        "test"
      ]
    }
  }
}
