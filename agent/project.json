{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "agent",
  "projectType": "library",
  "sourceRoot": "agent/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo build --workspace",
        "cwd": "agent"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "cargo build -p sparkly-cli --bins",
          "cargo rustc --example host --features std -- -C linker=target/debug/sparkly-link -C linker-flavor=gcc",
          "target/debug/examples/host"
        ],
        "parallel": false,
        "cwd": "agent"
      }
    },
    "check:types": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo check --workspace --features std,defmt",
        "cwd": "agent"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo clippy --workspace --all-targets --features std,defmt -- -D warnings",
        "cwd": "agent"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo fmt --all",
        "cwd": "agent"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo fmt --all -- --check",
        "cwd": "agent"
      }
    },
    "check": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        "lint",
        "format:check",
        "check:types",
        "test"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo test --workspace --features std,defmt",
        "cwd": "agent"
      }
    }
  }
}
