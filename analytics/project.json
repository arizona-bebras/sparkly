{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "analytics",
  "projectType": "application",
  "sourceRoot": "analytics",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "go build -o bin/analytics .",
        "cwd": "analytics"
      },
      "outputs": [
        "{projectRoot}/bin"
      ],
      "inputs": [
        "default",
        {
          "runtime": "go version"
        },
        {
          "env": "GOOS"
        },
        {
          "env": "GOARCH"
        },
        {
          "env": "CGO_ENABLED"
        },
        {
          "env": "GOFLAGS"
        }
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go vet ./...",
        "cwd": "analytics"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run .",
        "cwd": "analytics"
      }
    }
  }
}
