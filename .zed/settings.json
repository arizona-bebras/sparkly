{
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": {
        "external": {
          "command": "./frontend/node_modules/.bin/vp",
          "arguments": [
            "fmt",
            "--config",
            "frontend/vite.config.ts",
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
